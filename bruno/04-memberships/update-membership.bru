meta {
  name: Update Membership
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/memberships/{{userId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "plan": "pro"
  }
}

tests {
  test("status 200 or 404", function() {
    expect([200, 404]).to.include(res.status);
  });
}

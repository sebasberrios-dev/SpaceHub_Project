meta {
  name: Register Duplicate Email
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Test User",
    "email": "{{testEmail}}",
    "password": "password123"
  }
}

tests {
  test("status 409", function() {
    expect(res.status).to.equal(409);
  });
}

meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Test User",
    "email": "{{testEmail}}",
    "password": "password123"
  }
}

script:pre-request {
  bru.setEnvVar("testEmail", "test_" + Date.now() + "@example.com");
}

tests {
  test("status 201", function() {
    expect(res.status).to.equal(201);
  });
  test("has token", function() {
    expect(res.body.token).to.be.a("string");
  });
}


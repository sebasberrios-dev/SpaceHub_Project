meta {
  name: Create Space
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/spaces
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "name": "Sala A",
    "type": "private_room",
    "capacity": 10,
    "pricePerHour": 50,
    "location": "Sede Centro"
  }
}

